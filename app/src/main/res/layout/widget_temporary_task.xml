<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_temporary_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_temporary_background"
    android:contentDescription="@string/temporary_task_description"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_temporary_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/notification_temporary"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_temporary_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/temporary_widget_hint"
        android:textColor="#E4E9FF"
        android:textSize="11sp" />
</LinearLayout>
