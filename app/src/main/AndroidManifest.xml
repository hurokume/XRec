<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XRec">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.XRec" />
        <!-- Preserve existing launcher shortcuts while the implementation uses the XRec package. -->
        <activity-alias
            android:name="com.example.timerecorder.MainActivity"
            android:targetActivity=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".ActiveTaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started task time tracking with an ongoing elapsed-time notification and immediate task switching from the lock screen." />
        </service>

        <!-- Compatibility entry points for notifications and widgets created before the rename. -->
        <service
            android:name="com.example.timerecorder.ActiveTaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Compatibility entry point for user-started task tracking notifications from earlier XRec releases." />
        </service>

        <receiver
            android:name=".TaskActionReceiver"
            android:exported="false" />
        <receiver
            android:name="com.example.timerecorder.TaskActionReceiver"
            android:exported="false" />
        <receiver
            android:name="com.example.timerecorder.TemporaryTaskWidgetProvider"
            android:exported="false"
            android:label="@string/temporary_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/temporary_task_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
